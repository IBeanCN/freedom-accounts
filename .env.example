# Copy to .env and fill in real values before docker compose up

# Required: encryption key for sensitive DB fields
FA_ENCRYPTION_KEY=

# Required when binding to 0.0.0.0 (Docker / non-local)
# FA_ADMIN_USER=admin
FA_JWT_SECRET=
FA_ADMIN_PASSWORD=

# Application settings
# FA_PORT=8000
# FA_JWT_EXPIRE_HOURS=24
# FA_CALLBACK_TIMEOUT=15
# FA_MAX_CONCURRENCY=5

# CloakBrowser Docker image and Pro license
# The image contains the free binary; a Pro key downloads the Pro binary.
# CLOAKBROWSER_IMAGE=cloakhq/cloakbrowser:0.5.10
CLOAKBROWSER_LICENSE_KEY=

# Binary download and update behavior
# CLOAKBROWSER_AUTO_UPDATE=true
# CLOAKBROWSER_RELEASE_CHANNEL=stable
# CLOAKBROWSER_VERSION=
# CLOAKBROWSER_DOWNLOAD_URL=
# CLOAKBROWSER_SKIP_CHECKSUM=false
# CLOAKBROWSER_GEOIP_TIMEOUT_SECONDS=5

# Widevine/DRM is off by default in Docker. CDM fetching supports Linux x64 only.
# CLOAKBROWSER_WIDEVINE=1
# CLOAKBROWSER_FETCH_WIDEVINE=0
# CLOAKBROWSER_WIDEVINE_CDM=

# cloakserve CDP settings; app connects internally to http://browser:<port>
# CLOAKSERVE_PORT=9222
# CLOAKSERVE_IDLE_TIMEOUT=0
# Extra cloakserve/browser flags, for example: --headless=false
# CLOAKSERVE_EXTRA_ARGS=
