# 使用前复制为 .env，并填写真实配置后再执行 docker compose up。

# 必填：数据库敏感字段的加密密钥
FA_ENCRYPTION_KEY=

# 绑定 0.0.0.0（Docker/非本机访问）时必填
# FA_ADMIN_USER=admin
FA_JWT_SECRET=
FA_ADMIN_PASSWORD=

# 应用配置
# 监听 IP 用于控制宿主机访问入口；127.0.0.1 仅本机，0.0.0.0 表示所有网卡。
# FA_LISTEN_IP=127.0.0.1
# FA_PORT=8080
# FA_JWT_EXPIRE_HOURS=24
# FA_CALLBACK_TIMEOUT=15
# FA_MAX_CONCURRENCY=5

# CloakBrowser 镜像和 Pro License
# 官方镜像内置免费浏览器；填写 Pro Key 后会按授权下载 Pro 二进制。
# CLOAKBROWSER_IMAGE=cloakhq/cloakbrowser:0.5.10
CLOAKBROWSER_LICENSE_KEY=

# 浏览器二进制的下载和更新行为
# CLOAKBROWSER_AUTO_UPDATE=true
# CLOAKBROWSER_RELEASE_CHANNEL=stable
# CLOAKBROWSER_VERSION=
# 留空使用官方默认；非空会被 SDK 视为自定义下载源并禁用 Pro 下载路径。
# CLOAKBROWSER_DOWNLOAD_URL=
# CLOAKBROWSER_SKIP_CHECKSUM=false
# CLOAKBROWSER_GEOIP_TIMEOUT_SECONDS=5

# Widevine/DRM 在 Docker 中默认关闭；自动拉取 CDM 仅支持 Linux x64。
# CLOAKBROWSER_WIDEVINE=1
# CLOAKBROWSER_FETCH_WIDEVINE=0
# CLOAKBROWSER_WIDEVINE_CDM=

# cloakserve 会话空闲清理时间；0 表示禁用。应用容器内部固定访问 http://browser:9222。
# CLOAKSERVE_IDLE_TIMEOUT=0
